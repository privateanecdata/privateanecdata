---
import Base from '../layouts/Base.astro';
import { listReleases } from '../lib/releases';
const releases = listReleases();
const real = releases.filter((r) => !r.synthetic);
const latest = real[0];
const example = releases.find((r) => r.synthetic);
const tiers = [
  ['under 5', 'Any group this small is not shown, in any table.'],
  ['under 10', 'Nothing for that specific compound. Its reports are counted together with the other compounds in the same class.'],
  ['10+', 'Its report count, route of administration, and source type.'],
  ['50+', 'Intended purpose, dose ranges, frequency, duration, purity testing, side effects, and whether people are still taking it, finished, or stopped early.'],
  ['100+', 'Outcome by goal: of the people who took it hoping for X, how many reported no change, slight, moderate, or large improvement.'],
  ['200+', 'When each side effect started and whether it stopped. Percentages (with 95% confidence intervals) added beside the counts for everything above.'],
  ['1,000+', 'Outcome by goal shown side by side with other compounds used for the same goal.'],
];
---
<Base title="Published data">
  <h1>Published data</h1>
  {latest
    ? <p>The latest release is <a href={`/releases/${latest.dir}`}>{latest.release}</a>, computed on {latest.date} from {latest.counts.committed.toLocaleString('en-US')} committed reports.</p>
    : <p>Nothing yet. We have not collected enough reports to publish a release.</p>}
  {!latest && example && (
    <p>If you would like to see how future releases will be formatted, review this <a href={`/releases/${example.dir}`}>synthetic test data report</a> (<em>not real reports</em>).</p>
  )}

  <h2>Why nothing is published before a threshold</h2>
  <p>Our <a href="/docs/privacy-protocol#release-specification">privacy protocol</a> sets report thresholds for what can be published about a compound. For example, for a compound with fewer than 50 reports, we publish only its count, route, and kind of source. Once that compound reaches 50 reports, we begin publishing intended purpose, dose ranges, frequency, duration, purity testing, side effects, and whether people are still taking it. The table below is the complete list of thresholds.</p>

  <h2>Reporting thresholds for a specific compound</h2>
  <div class="ladder">
    {tiers.map(([at, what]) => (
      <div class:list={['rung', { locked: !latest }]}>
        <span class="n">{at.startsWith('under') ? at : `${at} reports`}</span>
        <span>{what}</span>
      </div>
    ))}
  </div>

  <h2>When and how we release reports</h2>
  <p>Monthly for the first year, then quarterly, in accordance with our release spec. Tables update in batches of at least five reports, so that comparing two releases can never single out one person's answers. Read the <a href="/docs/release-spec">TL;DR and the full spec</a>.</p>

  {real.length > 0 && (
    <>
      <h2>Releases</h2>
      <div class="release-list">
        {real.map((r) => <a href={`/releases/${r.dir}`}><span class="n">{r.release}</span><span>{r.date} · {r.counts.committed.toLocaleString('en-US')} committed · {r.counts.analyzed.toLocaleString('en-US')} analysed · root <code>{r.merkle.root.slice(0, 16)}…</code></span></a>)}
      </div>
    </>
  )}
</Base>
