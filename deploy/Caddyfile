# Reverse proxy for Private Anecdata. Access logging is OFF: no request line, no client IP, no
# user agent is written anywhere by this layer. Caddy still emits process-level logs (startup,
# certificate renewal, errors) to stderr; the global `log default` filter below strips request
# identity from error entries, and a failed TLS handshake is logged with the address that failed.
#
# Replace privateanecdata.org with the real host. Caddy provisions TLS automatically.
#
# Both paths to the app go through Caddy: the public hostname over TLS, and the onion service on a
# plain loopback port. Caddy replaces any client-supplied X-Forwarded-* headers (no trusted_proxies
# are configured, so none are trusted), which is what keeps the rate limiter honest on both paths.

{
    admin off
    # Handler errors (a 502 while the app restarts, a 500) are logged on the DEFAULT logger with
    # the request attached — the per-site `output discard` only silences the access log. Delete
    # the address, port, headers and path from every such entry before it is written.
    log default {
        output stderr
        format filter {
            wrap console
            fields {
                request>remote_ip delete
                request>remote_port delete
                request>client_ip delete
                request>headers delete
                request>uri delete
            }
        }
    }
}

# Headers stamped on every response, including the app's own 403/500 pages, which never reach the
# app's middleware. The same values are set in app/src/middleware.ts for the normal path.
(security) {
    header {
        Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
        Referrer-Policy "same-origin"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        Cross-Origin-Opener-Policy "same-origin"
        -Server
    }
    header /contribute* Cache-Control "no-store"
}

privateanecdata.org {
    log {
        output discard
    }
    import security
    encode zstd gzip
    # Caddy sets X-Forwarded-For to the real client address (discarding anything the client sent)
    # and X-Forwarded-Host to the request Host. Astro honours them only when that Host is the
    # PA_HOST the app was BUILT with (security.allowedDomains is fixed at build time).
    reverse_proxy 127.0.0.1:4321
}

# www → the bare name. Same discarded log and the same headers; nothing is proxied from here.
www.privateanecdata.org {
    log {
        output discard
    }
    import security
    redir https://privateanecdata.org{uri} permanent
}

# Onion service: tor forwards to this port (torrc: HiddenServicePort 80 127.0.0.1:8081). Plain
# HTTP on loopback; there is no client address on this path, and Caddy makes sure the client
# cannot invent one. The Host is the .onion name, which is not PA_HOST, so the app treats every
# request here as loopback and applies the shared ceiling rather than a per-address limit.
http://127.0.0.1:8081 {
    bind 127.0.0.1
    log {
        output discard
    }
    import security
    reverse_proxy 127.0.0.1:4321
}
