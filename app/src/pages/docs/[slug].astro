---
import Base from '../../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
const { slug } = Astro.params;
const spec = ['schema', 'release-spec'];
const entry = spec.includes(slug!) ? await getEntry('spec', slug!) : await getEntry('docs', slug!);
if (!entry) return new Response(null, { status: 404 });
const { Content } = await render(entry);
const title = (entry.body ?? '').match(/^#\s+(.+)$/m)?.[1] ?? slug;
---
<Base title={title!}>
  <article class="doc">
    <Content />
  </article>
</Base>
