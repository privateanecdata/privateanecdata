---
import Base from '../../layouts/Base.astro';
const pages = [
  ['privacy-protocol', 'Privacy protocol', 'What we promise, what is collected, what is never logged, how reports are de-identified, what is published — with what we cannot promise, the threat model, and the shutdown protocol beneath it.'],
  ['release-spec', 'Release spec', 'What is published and when, how we count reports, how to verify a release yourself, and the full specification.'],
  ['schema', 'Schema', 'Every field, every vocabulary, and the published uniqueness analysis.'],
];
---
<Base title="Methodology">
  <h1>Methodology</h1>
  <p class="lede">Everything we promise is written down, and the code that keeps the promises is public. These are the same files as in the repository. Start with the privacy protocol.</p>
  <ul class="doc-list">
    {pages.map(([slug, title, sub]) => <li><a href={`/docs/${slug}`}>{title}</a><span class="muted">{sub}</span></li>)}
  </ul>
  <p class="muted">The privacy statement, terms, legal process and subprocessors are together on the <a href="/legal">legal page</a>.</p>
</Base>
